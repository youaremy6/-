# ---------------------------------------------------------------------------
# 小甘 · 兰州话 ↔ 普通话 后端配置
# 复制为 .env 后填写。千万不要提交 .env 或任何真实密钥。
# 未填写的供应商会自动降级为内置 mock，/api/v1/health 会明确标注 mock。
# ---------------------------------------------------------------------------

# 运行环境：dev / test / prod
ENV=dev
# 小程序请求的公开地址（生成签名音频 URL 用；真机/云托管必须填公网 https 地址）
PUBLIC_BASE_URL=http://127.0.0.1:8000
# auto：有凭据就用真实供应商，没有就用 mock；mock：强制离线演示；live：缺凭据时标记 misconfigured
PROVIDER_MODE=auto

# --- 讯飞 甘肃话 ASR（spec 3A / 5.1）--------------------------------------
# 详细步骤见 docs/xfyun-setup.md；官方文档：
# https://www.xfyun.cn/doc/asr/voicedictation/API.html
# 控制台：我的应用 -> 添加“语音听写（流式版）” -> 方言/语种 -> 添加“甘肃话”
# 在讯飞控制台创建 WebAPI 应用并添加「语音听写（流式版）」后填写。
XF_APP_ID=
XF_API_KEY=
XF_API_SECRET=
# 必须在控制台「语音听写（流式版）→ 方言/语种」添加“甘肃话”后，复制页面显示的参数值。
# 禁止猜测或硬编码；为空时 live ASR 自动关闭。
XF_ACCENT_GANSU=
XF_DOMAIN=xfime-mianqie
XF_ASR_URL=wss://iat-api.xfyun.cn/v2/iat
XF_ASR_TIMEOUT_SECONDS=15

# --- 本地 Whisper：没有讯飞凭据时的真实识别兜底 -------------------------
# small 模型已能识别兰州话常用词；medium/large 更准但更慢、更占内存。
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- LLM：OpenAI 兼容接口（规范化为普通话 / 改写为兰州话）----------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_TEMPERATURE=0.1
LLM_INSTRUCT_VERSION=v1

# --- CosyVoice3 TTS（GPU 服务，可选）-------------------------------------
COSYVOICE_BASE_URL=
# 母语者书面同意后的参考音频：http(s) URL 或服务器本地路径，建议 <=30 秒
COSYVOICE_PROMPT_AUDIO_URL=
COSYVOICE_PROMPT_TEXT=
COSYVOICE_INSTRUCT=You are a helpful assistant. 请用甘肃话表达。<|endofprompt|>
COSYVOICE_SAMPLE_RATE=24000
COSYVOICE_TIMEOUT_SECONDS=30

# --- 对象存储（P0 用本地磁盘；留空则使用本地媒体目录）--------------------
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# 本地媒体目录；留空则使用 server/var/media（默认）。填写时请用绝对路径。
# MEDIA_DIR=
# 签名密钥；生产必须设置，留空时使用仅限开发环境的固定值
MEDIA_SIGNING_SECRET=
SIGNED_URL_TTL_SECONDS=3600

# --- 限制与隐私 -----------------------------------------------------------
MAX_AUDIO_BYTES=2000000
MAX_RECORD_SECONDS=30
MIN_RECORD_SECONDS=0.8
MAX_TEXT_CHARS=200
ASR_MIN_CONFIDENCE=0.45
ASR_HINT_CONFIDENCE=0.7
# 0 表示不持久化用户原始录音（处理完即删）
AUDIO_RETENTION_HOURS=0
# 生成语音在磁盘上的保留时间（供签名 URL 播放）
OUTPUT_AUDIO_TTL_MINUTES=60

# --- 缓存 ----------------------------------------------------------------
CACHE_TTL_SECONDS=1800
CACHE_MAX_ENTRIES=500
VOICE_ID=lanzhou-female-v1

# --- 调试 ----------------------------------------------------------------
# 允许 X-Mock-Behavior / X-Mock-Asr-Text 请求头做失败注入；prod 会自动关闭
ENABLE_DEBUG_HOOKS=true
