/**
 * 小甘 · visual direction
 * 黄河赭 #A84F32 / 深青 #2F625C / 暖米白 #FBF7EF / 墨色 #241F1A
 * 正文 32rpx（16px）起，关键译文 44-48rpx，按钮触控高度 >= 96rpx。
 */

page {
  background-color: #fbf7ef;
  color: #241f1a;
  font-size: 32rpx;
  line-height: 1.6;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 8rpx 0 20rpx;
}

.brand {
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #a84f32;
}

.subtitle {
  font-size: 26rpx;
  color: #6b6157;
}

.demo-banner {
  background: #fff4d6;
  color: #7a5312;
  border: 2rpx solid #ecd292;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.direction-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.direction-card {
  flex: 1;
  background: #fffdf8;
  border: 2rpx solid #e7ddcd;
  border-radius: 20rpx;
  padding: 22rpx 20rpx;
  min-height: 132rpx;
  box-sizing: border-box;
}

.direction-card.active {
  border-color: #a84f32;
  background: #fdf1e9;
  box-shadow: 0 6rpx 18rpx rgba(168, 79, 50, 0.12);
}

.dir-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #241f1a;
}

.direction-card.active .dir-title {
  color: #a84f32;
}

.dir-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b6157;
}

.scenario-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.chip {
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  border: 2rpx solid #d9ccb8;
  background: #fffdf8;
  font-size: 28rpx;
  color: #4a4036;
  min-height: 60rpx;
  display: flex;
  align-items: center;
}

.chip.active {
  background: #2f625c;
  border-color: #2f625c;
  color: #fbf7ef;
}

.card {
  background: #fffdf8;
  border: 2rpx solid #e7ddcd;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(36, 31, 26, 0.05);
}

.primary-btn {
  background: #a84f32 !important;
  color: #fffaf4 !important;
  border-radius: 18rpx !important;
  font-size: 34rpx !important;
  min-height: 96rpx;
  line-height: 96rpx;
  font-weight: 600;
}

.primary-btn[disabled] {
  opacity: 0.45;
}

.mini-btn {
  background: #fffdf8 !important;
  color: #241f1a !important;
  border: 2rpx solid #d9ccb8 !important;
  border-radius: 12rpx !important;
  font-size: 26rpx !important;
  margin: 0 12rpx 0 0 !important;
}

.mini-primary {
  background: #2f625c !important;
  color: #fbf7ef !important;
  border-color: #2f625c !important;
}

.text-btn {
  background: transparent !important;
  color: #2f625c !important;
  font-size: 28rpx !important;
  margin-top: 12rpx !important;
  min-height: 80rpx;
  line-height: 80rpx;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(36, 31, 26, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  z-index: 50;
}

.modal {
  width: 100%;
  background: #fffdf8;
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #241f1a;
  margin-bottom: 16rpx;
}

.modal-text {
  font-size: 30rpx;
  color: #4a4036;
  margin-bottom: 28rpx;
  line-height: 1.7;
}

.footer-note {
  text-align: center;
  font-size: 24rpx;
  color: #8a7f72;
  margin-top: 24rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  margin: 12rpx 0 20rpx;
}
