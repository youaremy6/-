.draft-notice {
  background: #fff4d6;
  color: #7a5312;
  border: 2rpx solid #ecd292;
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 26rpx;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.group-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #a84f32;
  margin: 24rpx 4rpx 12rpx;
  letter-spacing: 2rpx;
}

.tab-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.tab-row {
  display: flex;
  gap: 14rpx;
}

.phrase-card {
  padding: 24rpx;
}

.phrase-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
  flex-wrap: wrap;
}

.phrase-scenario {
  font-size: 24rpx;
  color: #2f625c;
  background: #eef4f1;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.badge {
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.badge-draft {
  background: #fff4d6;
  color: #7a5312;
  border: 2rpx solid #ecd292;
}

.badge-ok {
  background: #e6f2ec;
  color: #2f625c;
}

.badge-placeholder {
  display: inline-block;
  margin-top: 12rpx;
  background: #f1ece2;
  color: #6b6157;
  border: 2rpx solid #ded2be;
}

.phrase-mandarin {
  font-size: 28rpx;
  color: #6b6157;
  margin-bottom: 8rpx;
}

.phrase-lanzhou {
  font-size: 40rpx;
  font-weight: 700;
  color: #241f1a;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.phrase-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
  align-items: center;
}

.phrase-actions .mini-btn {
  margin: 0 !important;
}

.share-btn {
  margin-left: auto !important;
}

.full-mask {
  z-index: 80;
}

.full-panel {
  width: 100%;
  background: #fffdf8;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  position: relative;
}

.full-close {
  position: absolute;
  right: 28rpx;
  top: 20rpx;
  font-size: 26rpx;
  color: #6b6157;
  padding: 12rpx;
}

.full-label {
  font-size: 24rpx;
  color: #a84f32;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
}

.full-lanzhou {
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.45;
  color: #241f1a;
  margin-bottom: 20rpx;
  word-break: break-all;
}

.full-mandarin {
  font-size: 28rpx;
  color: #6b6157;
  line-height: 1.6;
  margin-bottom: 14rpx;
}

.full-actions {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
