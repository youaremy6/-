.talk-panel {
  margin: 8rpx 0 24rpx;
}

.talk-button {
  min-height: 360rpx;
  border-radius: 32rpx;
  background: linear-gradient(160deg, #b25a3b 0%, #a84f32 55%, #8f4129 100%);
  color: #fffaf4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-shadow: 0 14rpx 32rpx rgba(168, 79, 50, 0.28);
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}

.talk-button.is-busy {
  opacity: 0.55;
}

.talk-button.is-recording {
  background: linear-gradient(160deg, #2f625c 0%, #24504b 100%);
  box-shadow: 0 14rpx 36rpx rgba(47, 98, 92, 0.34);
  transform: scale(0.99);
}

.talk-icon {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 18rpx;
}

.talk-button.is-recording .talk-icon {
  color: #ffd9c9;
  animation: breathe 1s ease-in-out infinite;
}

@keyframes breathe {
  0% {
    opacity: 0.45;
  }
  50% {
    opacity: 1;
  }
  100% {
    opacity: 0.45;
  }
}

.talk-text {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.talk-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.82;
}

.talk-note {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8a7f72;
}

.compose {
  margin-top: 8rpx;
}

.compose-input {
  width: 100%;
  min-height: 160rpx;
  font-size: 36rpx;
  line-height: 1.6;
  color: #241f1a;
  box-sizing: border-box;
}

.compose-btn {
  margin-top: 24rpx;
}

.hint {
  margin: 8rpx 0 20rpx;
  padding: 18rpx 22rpx;
  background: #fdf1e9;
  border-left: 6rpx solid #a84f32;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #6a3b26;
}

.error-card {
  border-color: #e7b9a8;
  background: #fff6f2;
}

.error-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #8f3418;
}

.error-message {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #5a443c;
  line-height: 1.6;
}

.error-actions {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.dialog {
  margin-bottom: 24rpx;
}

.bubble {
  max-width: 92%;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.bubble.left {
  background: #f1ece2;
  border: 2rpx solid #e2d8c8;
}

.bubble.right {
  margin-left: auto;
  background: #eef4f1;
  border: 2rpx solid #cfe0d9;
}

.bubble-tag {
  font-size: 24rpx;
  color: #6b6157;
  margin-bottom: 10rpx;
}

.bubble-text {
  font-size: 34rpx;
  line-height: 1.6;
  color: #241f1a;
  word-break: break-all;
}

.bubble-text.output {
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.5;
}

.back-translation {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #5c6f69;
}

.edit-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 36rpx;
  line-height: 1.6;
  background: #fffdf8;
  border: 2rpx solid #cfe0d9;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
}

.edit-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.edit-hint {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b6157;
}

.notice {
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  font-size: 27rpx;
  line-height: 1.6;
  margin-bottom: 14rpx;
}

.notice.warn {
  background: #fff4d6;
  color: #7a5312;
  border: 2rpx solid #ecd292;
}

.notice.demo {
  background: #eef4f1;
  color: #2f625c;
  border: 2rpx solid #cfe0d9;
}

.result-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.action-btn {
  flex: 1;
  min-height: 96rpx;
  line-height: 96rpx;
  background: #fffdf8 !important;
  color: #241f1a !important;
  border: 2rpx solid #d9ccb8 !important;
  border-radius: 16rpx !important;
  font-size: 30rpx !important;
  margin: 0 !important;
  padding: 0 !important;
}

.action-btn[disabled] {
  opacity: 0.4;
  color: #8a7f72 !important;
}

.audio-note {
  margin-top: 14rpx;
  text-align: right;
  font-size: 22rpx;
  color: #8a7f72;
}

.bottom-nav {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.nav-item {
  flex: 1;
  min-height: 96rpx;
  border-radius: 16rpx;
  border: 2rpx solid #d9ccb8;
  background: #fffdf8;
  color: #2f625c;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 600;
}

.demo-banner.offline {
  background: #fdecea;
  color: #8f3418;
  border-color: #e7b9a8;
}
