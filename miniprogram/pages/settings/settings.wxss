.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}

.switch-row {
  margin-top: 16rpx;
}

.row-label {
  font-size: 30rpx;
  color: #241f1a;
}

.row-label.block {
  display: block;
  margin-bottom: 14rpx;
}

.row-value {
  font-size: 30rpx;
  color: #2f625c;
  font-weight: 600;
}

.row-value.small {
  font-size: 23rpx;
  max-width: 430rpx;
  text-align: right;
  word-break: break-all;
}

.segmented {
  display: flex;
  gap: 12rpx;
}

.segment {
  flex: 1;
  min-height: 88rpx;
  border-radius: 14rpx;
  border: 2rpx solid #d9ccb8;
  background: #fffdf8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #4a4036;
}

.segment.active {
  background: #2f625c;
  border-color: #2f625c;
  color: #fbf7ef;
  font-weight: 600;
}

.muted {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8a7f72;
}

.privacy-item {
  font-size: 27rpx;
  line-height: 1.7;
  color: #4a4036;
  padding: 6rpx 0;
}

.danger-btn {
  margin-top: 22rpx !important;
  background: #fdecea !important;
  color: #8f3418 !important;
  border: 2rpx solid #e7b9a8 !important;
  border-radius: 14rpx !important;
  font-size: 30rpx !important;
  min-height: 96rpx;
  line-height: 96rpx;
}

.danger-btn[disabled] {
  opacity: 0.5;
}

.reset-btn {
  margin: 20rpx 12rpx 0 0 !important;
}
